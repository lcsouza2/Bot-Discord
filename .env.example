# Token de autenticação do Bot do Discord (obtido em https://discord.com/developers/applications)
DISCORD_TOKEN=seu_token_aqui

# Prefixo padrão para comandos de texto opcionais (ex: !play, !queue)
COMMAND_PREFIX=!

# ID do Servidor (Guild ID) para registro imediato de Slash Commands em ambiente de desenvolvimento.
# Deixe em branco para sincronização global (pode demorar até 1 hora no Discord).
GUILD_ID=
